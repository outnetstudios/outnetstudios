<IfModule mod_rewrite.c>
  RewriteEngine On

  # Redirect non-HTTPS requests, but let ACME challenges through.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{REQUEST_URI} !^/\.well-known/acme-challenge/
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # Keep legacy HTML entry points working.
  RewriteRule ^(index|hireus|mission)\.html$ /$1.php [L,R=301]
</IfModule>

DirectoryIndex index.php
